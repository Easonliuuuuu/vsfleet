FROM gcr.io/distroless/static-debian13:nonroot@sha256:d62067879de890a1def9da0e7766b7d20810a5e5555cef8506b752437d7a3e88

# The Kubernetes integration fixture builds this binary alongside the product
# image. It is intentionally CI-only: production images contain only vsfleet.
COPY --chmod=0555 linux/amd64/vsfleet-vcsim /usr/bin/vsfleet-vcsim

USER 65532:65532
ENTRYPOINT ["/usr/bin/vsfleet-vcsim"]
